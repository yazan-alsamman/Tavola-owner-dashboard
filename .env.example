# Tavla Platform — environment variables
# Copy to `.env.local`. Never commit real credentials.

VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=https://api.tavola.business

# Browse without Platform Admin login. Leave unset or `false` to require sign-in.
# VITE_PLATFORM_PREVIEW=true

# Restaurant dashboard (separate app)
# VITE_RESTAURANT_APP_URL=http://localhost:5173/login
